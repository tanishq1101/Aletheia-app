# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
# Any .env.example, at any depth. Without this, `.env*` above silently swallows
# the example file next to a new deploy target -- `git add -A` skips it without
# a word, and the first symptom is a deploy doc telling someone to copy a file
# that is not in the repo. A negation with no slash matches at every level.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI tooling artifacts — never commit these
AGENTS.md
CLAUDE.md
GEMINI.md
.claude/
.codex/
.cursor/
.cursorrules
.aider*
.windsurfrules
.github/copilot-instructions.md

# The notebook build/validate scripts run from the repo root.
__pycache__/
.pytest_cache/
