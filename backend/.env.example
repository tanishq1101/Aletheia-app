# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Neon is the primary database. This one file is the single source of the
# connection string: FastAPI reads it here, and prisma.config.ts loads this
# same file, so a migration cannot be applied to a different database than the
# app is talking to.
#
# Local docker-compose Postgres + pgvector, for development and the test suite:
DATABASE_URL=postgresql://research:research@localhost:5433/research_intelligence
#
# Neon — use the POOLED endpoint (the host contains "-pooler"):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#
# Neon's DIRECT (unpooled) endpoint — same host without "-pooler". Only the
# Prisma CLI uses it, and it uses it in preference to DATABASE_URL: PgBouncer
# in transaction mode cannot hold the session-level advisory locks a migration
# takes, so `prisma migrate` against the pooled URL hangs or fails. Leave unset
# for local Postgres, which has no pooler in front of it.
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require

# --- Vector store (ChromaDB) -------------------------------------------------
# Chroma is the PRIMARY index for chunk embeddings; the same vectors stay
# mirrored in paper_chunks.embedding, and retrieval falls back to pgvector
# whenever Chroma cannot answer. Setting CHROMA_ENABLED=false is therefore a
# supported mode, not a broken one — it is how the test suite runs with no
# container. Start the server with: docker compose up -d chroma
CHROMA_ENABLED=true
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
# Only for a hosted Chroma that authenticates with a bearer token.
CHROMA_AUTH_TOKEN=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
# One collection for the whole deployment; project scoping is a metadata
# filter, so a single HNSW graph serves every project.
CHROMA_COLLECTION=aletheia_chunks
CHROMA_TIMEOUT_SECONDS=10

# --- Storage ----------------------------------------------------------------
# Which StorageBackend to use: "local" (Sprint 1) or "supabase" (not implemented yet).
STORAGE_BACKEND=local
# Where LocalStorage writes uploaded PDFs. Relative paths resolve from the repo root.
LOCAL_STORAGE_DIR=storage

# --- Upload limits ----------------------------------------------------------
MAX_UPLOAD_BYTES=52428800

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase (superseded) ---------------------------------------------------
# Sprint 1 planned a Supabase migration; the platform moved to Neon instead
# (same Postgres, same pgvector, no rewrite). These are kept only because the
# storage backend still reads them if STORAGE_BACKEND=supabase, which is not
# implemented. Uploaded PDFs live on local disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=papers

# --- AI providers -----------------------------------------------------------
# Embeddings and reranking run locally (fastembed / ONNX) — no key, no spend.
# Only the answering LLM is hosted.
#
# OpenRouter (OpenAI-compatible). Get a key at https://openrouter.ai/keys.
# Answering does not work without this; the API returns a 503 saying so rather
# than silently degrading to an ungrounded answer.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default chosen for instruction-following, which is what grounding and honest
# refusal actually depend on. ~$0.009 per answer at ~7K in / ~400 out.
# Cheaper alternatives, both verified present on OpenRouter:
#   google/gemini-3.1-flash-lite   $0.25/$1.50 per M
#   openai/gpt-5-mini              $0.25/$2.00 per M
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# --- Free alternatives, if the OpenRouter balance runs out -------------------
# Every provider below speaks the same OpenAI chat-completions shape, so
# switching is these three variables and nothing else. LLM_BASE_URL and
# LLM_MODEL may be left blank to accept the provider's default.
#
# Google Gemini — the recommended option. It does vision, which figure
# interpretation needs. Create a key at https://aistudio.google.com/apikey.
# Set these exact values in the untracked backend/.env file:
#   LLM_PROVIDER=gemini
#   GEMINI_API_KEY=<your Google AI Studio API key>
#   LLM_MODEL=gemini-2.5-flash
#
# Groq — free and very fast, but text-only, so figure interpretation will fail
# loudly instead of guessing. Key: https://console.groq.com/keys
#   LLM_PROVIDER=groq
#   LLM_API_KEY=<your Groq key>
#   LLM_MODEL=llama-3.3-70b-versatile
#
# Ollama — a local model. No key, no quota, nothing leaves the machine.
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.1:8b
#
# Anything else OpenAI-shaped:
#   LLM_PROVIDER=custom
#   LLM_BASE_URL=https://.../v1
#   LLM_API_KEY=...
#   LLM_MODEL=...
LLM_API_KEY=
GEMINI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# --- Authentication (Clerk) --------------------------------------------------
# Session tokens are verified locally against Clerk's published JWKS, so the
# secret key is not needed to authenticate a request.
#
# CLERK_ISSUER is what switches authentication on. Find it in the Clerk
# dashboard under "API keys" -> "Show JWT public key" (it is your Frontend API
# URL, e.g. https://tidy-cat-42.clerk.accounts.dev).
CLERK_ISSUER=
# Optional. Derived from CLERK_ISSUER when blank.
CLERK_JWKS_URL=
# Only needed for Clerk's Backend API (user lookup, revocation).
CLERK_SECRET_KEY=
# Only if your JWT template adds an `aud` claim; blank means "not checked",
# which is honest about a claim Clerk does not set by default.
CLERK_AUDIENCE=
# Comma-separated origins allowed to present a token here (the `azp` claim).
# Blank skips the check, which is right for a single-origin deployment.
CLERK_AUTHORIZED_PARTIES_CSV=

# With no CLERK_ISSUER the API refuses to start unless this says the openness
# is deliberate. That is the point: a deployment that forgets to configure an
# identity provider fails loudly instead of serving everyone's data.
ALLOW_UNAUTHENTICATED=false

# --- Rate limiting -----------------------------------------------------------
# Sliding windows, per signed-in user (or per IP when anonymous). In-memory, so
# these are per process: N workers permit roughly N times these rates. Not a
# substitute for an upstream WAF.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
# Much smaller, because these routes cost money per call and take seconds.
RATE_LIMIT_LLM_REQUESTS_PER_MINUTE=12
RATE_LIMIT_UPLOADS_PER_HOUR=60

# --- Retrieval tuning -------------------------------------------------------
# PRD 5.1 step 7: semantic top ~20 -> rerank -> top 5-8 evidence chunks.
SEARCH_TOP_K=20
RERANK_TOP_K=6
RERANK_MODEL=jinaai/jina-reranker-v1-turbo-en
CONTEXT_MAX_TOKENS=6000

# Experimental local classifiers; advisory only, not claim verification.
RESEARCH_MODELS_ENABLED=true
RESEARCH_MODELS_DIR=models/research
