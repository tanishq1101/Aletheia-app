# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Neon is the primary database. This one file is the single source of the
# connection string: FastAPI reads it here, and prisma.config.ts loads this
# same file, so a migration cannot be applied to a different database than the
# app is talking to.
#
# Local docker-compose Postgres + pgvector, for development and the test suite:
DATABASE_URL=postgresql://research:research@localhost:5433/research_intelligence
#
# Neon — use the POOLED endpoint (the host contains "-pooler"):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#
# Neon's DIRECT (unpooled) endpoint — same host without "-pooler". Only the
# Prisma CLI uses it, and it uses it in preference to DATABASE_URL: PgBouncer
# in transaction mode cannot hold the session-level advisory locks a migration
# takes, so `prisma migrate` against the pooled URL hangs or fails. Leave unset
# for local Postgres, which has no pooler in front of it.
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require

# --- Vector store (ChromaDB) -------------------------------------------------
# Chroma is the PRIMARY index for chunk embeddings; the same vectors stay
# mirrored in paper_chunks.embedding, and retrieval falls back to pgvector
# whenever Chroma cannot answer. Setting CHROMA_ENABLED=false is therefore a
# supported mode, not a broken one — it is how the test suite runs with no
# container. Start the server with: docker compose up -d chroma
CHROMA_ENABLED=true
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
# Only for a hosted Chroma that authenticates with a bearer token.
CHROMA_AUTH_TOKEN=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
# One collection for the whole deployment; project scoping is a metadata
# filter, so a single HNSW graph serves every project.
CHROMA_COLLECTION=aletheia_chunks
CHROMA_TIMEOUT_SECONDS=10

# --- Storage ----------------------------------------------------------------
# Which StorageBackend to use: "local" (Sprint 1) or "supabase" (not implemented yet).
STORAGE_BACKEND=local
# Where LocalStorage writes uploaded PDFs. Relative paths resolve from the repo root.
LOCAL_STORAGE_DIR=storage

# --- Upload limits ----------------------------------------------------------
MAX_UPLOAD_BYTES=52428800

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase (superseded) ---------------------------------------------------
# Sprint 1 planned a Supabase migration; the platform moved to Neon instead
# (same Postgres, same pgvector, no rewrite). These are kept only because the
# storage backend still reads them if STORAGE_BACKEND=supabase, which is not
# implemented. Uploaded PDFs live on local disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=papers

# =============================================================================
# AI PROVIDER 1 of 2 — OpenAI
# =============================================================================
# Embeddings and reranking run locally (fastembed / ONNX) — no key, no spend.
# Only the answering LLM is hosted, and exactly ONE of the two providers below
# is enabled at a time.
#
# `*_ENABLED` is the switch; the presence of a key is not. A disabled provider
# is never called — not as a standby, not when the enabled one fails. Both
# false, or both true, is a configuration error that names itself on startup
# rather than picking one for you.
#
# Key: https://platform.openai.com/api-keys
OPENAI_ENABLED=true
OPENAI_API_KEY=
# Blank accepts the model named in the `openai` entry of PROVIDER_PROFILES
# (services/llm.py), so the model lives in exactly one place.
OPENAI_MODEL=

# =============================================================================
# AI PROVIDER 2 of 2 — Google Gemini
# =============================================================================
# To use this one instead: GEMINI_ENABLED=true and OPENAI_ENABLED=false.
# Google exposes an OpenAI-compatible endpoint, so switching changes nothing
# but these variables. It does vision, which figure interpretation needs.
#
# Key: https://aistudio.google.com/apikey
# (gemini-2.5-flash is no longer issued to new API keys — Google's API returns
# a 404 telling callers to switch to gemini-3.6-flash. Verified directly
# against the API; check aistudio.google.com if this drifts again.)
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Shared by whichever provider is enabled ---------------------------------
# Temperature 0: grounding is constraint-following, not a creative task, and a
# deterministic answer is one that can actually be re-verified.
#
# REQUESTED, NOT GUARANTEED. The whole gpt-5.5/5.6 generation (luna, sol,
# terra) rejects any temperature but its own default, and the client drops the
# field rather than failing the request. Those models therefore answer at their
# own sampling and do NOT reproduce their answers — `seed` is accepted but does
# not reproduce them either, measured. Whether determinism survived is reported
# on every answer and printed on every exported PDF, so a reader is never told
# an answer is re-runnable when it is not. Only gpt-5.4 and older honour 0.0.
LLM_TEMPERATURE=0.0

# On a reasoning model this budget covers hidden reasoning AND the visible
# answer, and the split is not proportional. Measured on gpt-5.6-luna: a
# ceiling of 2048 went entirely to reasoning and returned an empty completion,
# while 8192 reasoned for 69 tokens and wrote a full answer. 2048 was therefore
# below the floor at which that model writes anything at all — which is what
# made the research agent's combined report fail.
LLM_MAX_OUTPUT_TOKENS=8192

# The largest ceiling the client may raise itself to when a model reports it
# spent the whole budget without answering. A bound, not a target: only a model
# that has already failed once ever reaches it.
LLM_MAX_OUTPUT_TOKENS_CEILING=32768

# Reasoning models think before they write, and a combined research report is a
# long write. 60 was tuned for a non-reasoning model.
LLM_TIMEOUT_SECONDS=180

# --- Authentication (Clerk) --------------------------------------------------
# Session tokens are verified locally against Clerk's published JWKS, so the
# secret key is not needed to authenticate a request.
#
# CLERK_ISSUER is what switches authentication on. Find it in the Clerk
# dashboard under "API keys" -> "Show JWT public key" (it is your Frontend API
# URL, e.g. https://tidy-cat-42.clerk.accounts.dev).
CLERK_ISSUER=
# Optional. Derived from CLERK_ISSUER when blank.
CLERK_JWKS_URL=
# Only needed for Clerk's Backend API (user lookup, revocation).
CLERK_SECRET_KEY=
# Only if your JWT template adds an `aud` claim; blank means "not checked",
# which is honest about a claim Clerk does not set by default.
CLERK_AUDIENCE=
# Comma-separated origins allowed to present a token here (the `azp` claim).
# Blank skips the check, which is right for a single-origin deployment.
CLERK_AUTHORIZED_PARTIES_CSV=

# With no CLERK_ISSUER the API refuses to start unless this says the openness
# is deliberate. That is the point: a deployment that forgets to configure an
# identity provider fails loudly instead of serving everyone's data.
ALLOW_UNAUTHENTICATED=false

# --- Rate limiting -----------------------------------------------------------
# Sliding windows, per signed-in user (or per IP when anonymous). Not a
# substitute for an upstream WAF.
#
# REDIS_URL decides where the counters live. Blank keeps them in this process,
# which is exact for a single worker and roughly N times these rates for N
# workers. Set it and the numbers below are the real, cluster-wide limits.
# Redis is used only for this: if it is unreachable the limiter falls back to
# the in-process window and /health says so, rather than the API going down.
# docker-compose sets this to the bundled redis service automatically.
REDIS_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
# Much smaller, because these routes cost money per call and take seconds.
RATE_LIMIT_LLM_REQUESTS_PER_MINUTE=12
RATE_LIMIT_UPLOADS_PER_HOUR=60

# --- Retrieval tuning -------------------------------------------------------
# PRD 5.1 step 7: semantic top ~20 -> rerank -> top 5-8 evidence chunks.
SEARCH_TOP_K=20
RERANK_TOP_K=6
RERANK_MODEL=jinaai/jina-reranker-v1-turbo-en
CONTEXT_MAX_TOKENS=6000

# Experimental local classifiers; advisory only, not claim verification.
RESEARCH_MODELS_ENABLED=true
RESEARCH_MODELS_DIR=models/research
