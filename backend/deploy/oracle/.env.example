# Runtime configuration for the Oracle deployment.
#
# Copy to `.env` ON THE INSTANCE and fill in. It is never rsynced from a laptop
# (deploy.sh excludes it), because a dev .env points at a dev database and
# shipping it silently is the worst kind of deploy bug.
#
#     cp .env.example .env && $EDITOR .env
#
# `.env` is covered by backend/.gitignore, so it cannot be committed.

# --- The hostname Caddy gets a certificate for ------------------------------
# Must already resolve to this instance's public IP before the first deploy.
# Caddy requests a Let's Encrypt certificate on startup and failed challenges
# are rate limited, so check `dig +short <host>` from your laptop first.
# A free DuckDNS subdomain works and is on the Public Suffix List; so does a
# domain you own. No port, no scheme, no trailing dot.
API_DOMAIN=aletheia-api.duckdns.org

# --- Database ---------------------------------------------------------------
# Neon, including ?sslmode=require. The same database the frontend reads.
DATABASE_URL=

# --- Who may call this API --------------------------------------------------
# The Vercel origin, exactly, no trailing slash. The browser calls this API
# cross-origin, so a wrong value here is a CORS failure in the app, not a
# network error. Comma-separated to add preview domains.
CORS_ORIGINS=https://aletheia-rag.vercel.app

# --- Authentication ---------------------------------------------------------
# CLERK_ISSUER is what switches auth on, and the API refuses to start without it
# unless ALLOW_UNAUTHENTICATED says the openness is deliberate. Both are here so
# the dangerous state cannot be reached by forgetting one.
CLERK_ISSUER=
ALLOW_UNAUTHENTICATED=false
# Only the Vercel origin may present a token here (the azp claim), so a token
# minted for another site cannot be replayed against this API.
CLERK_AUTHORIZED_PARTIES_CSV=https://aletheia-rag.vercel.app

# --- The answering model ----------------------------------------------------
# Two providers, one switch each; exactly one may be true. A disabled provider
# is never called, so setting both false -- or both true -- stops answering with
# a message naming the mistake rather than guessing which you meant.
GEMINI_ENABLED=true
GEMINI_API_KEY=
OPENAI_ENABLED=false
OPENAI_API_KEY=
# Blank so each model name comes from its provider profile in services/llm.py,
# which is the single place they are written down.
GEMINI_MODEL=
OPENAI_MODEL=

# --- Storage ----------------------------------------------------------------
# `local` is correct here and is why this host is simpler than Cloud Run: an
# instance has a real disk that survives a restart, so the PDFs live on the
# `papers` named volume and no object store is involved. LOCAL_STORAGE_DIR is
# NOT set here -- docker-compose.yml pins it to the in-image mount point.
#
# To switch to R2 later, set STORAGE_BACKEND=r2 and the four R2_* values, then
# run `npm run storage:to-r2` once to copy existing bytes across. Nothing else
# changes; storage.py already implements both.
STORAGE_BACKEND=local
# R2_ENDPOINT_URL=
# R2_BUCKET=aletheia-papers
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Vector store -----------------------------------------------------------
# Retrieval falls back to pgvector in Neon, verified to return the same chunk
# ids in the same order with the same scores to four decimal places.
CHROMA_ENABLED=false

# --- Rate limiting ----------------------------------------------------------
# REDIS_URL is deliberately empty: with exactly one API container the limiter's
# in-process windows are the real cluster-wide counters, not an approximation.
# Set it only if a second instance ever exists.
REDIS_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_LLM_REQUESTS_PER_MINUTE=12
RATE_LIMIT_UPLOADS_PER_HOUR=60

# --- Ingestion memory -------------------------------------------------------
# The A1 shape has 24 GB, so unlike a 4 GiB Cloud Run service this host has room
# to raise the batch width. Measured peak on aarch64 for one 75-page paper is
# 2.28 GB at 4; batch 32 measured 4.79 GB on amd64. Raising it trades RAM for a
# faster background ingest and changes nothing a user sees, so it is only worth
# doing if ingest latency actually bothers you. mem_limit in
# docker-compose.yml is 6g -- raise that first, or the container is OOM-killed.
EMBED_BATCH_SIZE=4

LOG_LEVEL=INFO
