# Copy to .env.local.
#
# Leave NEXT_PUBLIC_API_URL blank: the app then calls `/api/py/*` on its own
# origin, and `next dev` proxies that to the FastAPI service on port 8000
# (BACKEND_DEV_URL to change the port). Same URLs as production, no CORS.
# Set it only to point at a backend somewhere else; that origin must then be
# in the API's CORS_ORIGINS.
NEXT_PUBLIC_API_URL=
# BACKEND_DEV_URL=http://127.0.0.1:8000

# --- Authentication (Clerk) --------------------------------------------------
# Create an application at https://dashboard.clerk.com, then enable Google
# under "SSO connections" and turn on Email address and Username under
# "Email, phone, username". Paste both keys here.
#
# Leave these blank and the app runs exactly as it did before: no accounts, one
# seeded development user, and a sign-in page that says so.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk's own pages live. These match the routes in app/(auth)/.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
